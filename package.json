{
  "name": "torrent-bul",
  "productName": "Torrent Bul",
  "version": "1.0.0",
  "description": "Konu, tür ya da film adıyla torrent bulup tek tıkla indiren sade masaüstü uygulaması.",
  "type": "module",
  "main": "electron/main.js",
  "license": "MIT",
  "author": "kaptanoguz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaptanoguz/torrent.git"
  },
  "homepage": "https://github.com/kaptanoguz/torrent#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "web": "node bin/web.js",
    "test": "node --test --test-force-exit",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.kaptanoguz.torrentbul",
    "productName": "Torrent Bul",
    "files": [
      "electron/**",
      "src/**",
      "public/**",
      "bin/**",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network"
    }
  }
}
